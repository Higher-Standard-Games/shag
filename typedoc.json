{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/engine"],
  "entryPointStrategy": "expand",
  "out": "docs/api",
  "skipErrorChecking": true,
  "name": "SHAG Engine API",
  "readme": "src/engine/README.md",
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "includeVersion": false,
  "categorizeByGroup": true,
  "categoryOrder": ["Core", "UI", "Rendering", "Audio", "Debug", "*"],
  "navigationLinks": {
    "SHAG Engine": "https://github.com/Higher-Standard-Games/shag",
    "Changelog": "https://github.com/Higher-Standard-Games/shag/tree/main/docs/changelog"
  },
  "customCss": "docs/api-theme.css",
  "gitRevision": "main",
  "hideGenerator": true,
  "searchInComments": true
}
