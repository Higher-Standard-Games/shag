{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "skipLibCheck": true,
        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        /* Path aliases */
        "baseUrl": ".",
        "paths": {
            "@game/*": [
                "src/games/fps/*"
            ],
            "@engine/server": [
                "src/engine/server/index.ts"
            ],
            "@engine/server/*": [
                "src/engine/server/*"
            ],
            "@shared/server": [
                "src/shared/server/index.ts"
            ],
            "@shared/server/*": [
                "src/shared/server/*"
            ],
            "@games/fps/server": [
                "src/games/fps/server/index.ts"
            ],
            "@games/fps/server/*": [
                "src/games/fps/server/*"
            ]
        },
        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitOverride": true
    },
    "include": [
        "src"
    ]
}