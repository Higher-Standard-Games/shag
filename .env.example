# Browser-visible lobby WebSocket URL.
# Local default used by code when unset:
# VITE_LOBBY_URL=ws://localhost:9000
VITE_LOBBY_URL=ws://localhost:9000

# Public address advertised by the lobby for spawned game servers.
# Local defaults used by code when unset:
# SHAG_PUBLIC_GAME_PROTOCOL=ws
# SHAG_PUBLIC_GAME_HOST=localhost
SHAG_PUBLIC_GAME_PROTOCOL=ws
SHAG_PUBLIC_GAME_HOST=localhost

# TLS certificate paths used by spawned game servers when serving direct wss://
# sockets. Leave unset/missing for local ws:// development.
# SHAG_GAME_CERT_PATH=./certs/localhost.pem
# SHAG_GAME_KEY_PATH=./certs/localhost-key.pem

# Example live deployment:
# VITE_LOBBY_URL=wss://your-domain.example:9000
# SHAG_PUBLIC_GAME_PROTOCOL=wss
# SHAG_PUBLIC_GAME_HOST=your-domain.example
# SHAG_GAME_CERT_PATH=/etc/letsencrypt/live/your-domain.example/fullchain.pem
# SHAG_GAME_KEY_PATH=/etc/letsencrypt/live/your-domain.example/privkey.pem

# ── Lobby and bot server ───────────────────────────────────────────────────
# Where accounts, results and the shared bot secret live. The lobby and bot
# server CLIs also take --data-dir, which wins over this.
# SERVER_DATA_DIR=./server-data

# Shared secret proving a bot connection to the lobby. Both processes read it;
# whichever starts first writes one into the data directory when it is unset.
# BOT_SECRET=

# Bot server control socket the lobby asks for bots, and the lobby URL a
# spawned bot connects back to.
# BOT_SERVER_URL=ws://127.0.0.1:9100
# LOBBY_BOT_CONNECT_URL=ws://127.0.0.1:9000

# How long the lobby waits for a spawned game server to report ready, in
# milliseconds. Clamped to 5s-5min; the default is 45s.
# SHAG_SPAWN_TIMEOUT_MS=45000

# ── Spawned game servers ───────────────────────────────────────────────────
# The lobby sets these per match; they are not meant to be set by hand. The
# first carries that match's seat manifest, the second signs its result line.
# SHAG_MATCH_ADMISSION=
# SHAG_MATCH_RESULT_SECRET=

# Match rules a server can be started with. A bare number is minutes for the
# time limit and seconds for warmup; suffix with s/m for either.
# SHAG_TIMELIMIT=10
# SHAG_WARMUP=30
# SHAG_SCORELIMIT=

# ── Headless and tooling ───────────────────────────────────────────────────
# Asset directory for headless runs, and where bot navigation caches land.
# GAME_PATH=
# BOT_NAV_CACHE_DIR=./.cache/bots/maps
# BOT_GOAL_ARBITER=

# SHAGGED local map service (npm run shagged:server). CLI flags override these.
# Server Save/Open is available; compile jobs and browser wiring are still pending.
# SHAGGED_MAPS_ROOT=./server-data/shagged/maps
# SHAGGED_PORT=9010
# SHAGGED_UI_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# SHAGGED_MAKEBSP_BIN=C:/tools/netradiant/makebsp.exe
# SHAGGED_MAKELIGHT_BIN=C:/tools/netradiant/makelight.exe
# SHAGGED_MEDIA_ROOT=./public/data
# SHAGGED_TOOLCHAIN_ROOT=C:/tools/netradiant
# SHAGGED_DEFAULT_QUALITY=fast
