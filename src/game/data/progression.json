  "titles": [
    { "id": "novice", "name": "Novice Grower", "minLevel": 1 },
    { "id": "apprentice", "name": "Apprentice Grower", "minLevel": 5 },
    { "id": "master_grower", "name": "Master Grower", "minLevel": 10 },
    { "id": "expert_breeder", "name": "Expert Breeder", "minLevel": 25 },
    { "id": "cannabis_tycoon", "name": "Cannabis Tycoon", "minLevel": 40 },
    { "id": "legend", "name": "Legend", "minLevel": 50 }
  ],
  "xpSources": {
    "harvest_plant": { "base": 25, "perQuality": 0.5 },
    "complete_order": { "base": 50, "perValue": 0.1 },
    "complete_quest": { "base": 100 },
    "breed_strain": { "base": 75, "perTrait": 25 },
