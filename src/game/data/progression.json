    "xpCurve": {
      "type": "formula",
      "base": 100,
      "exponent": 1.5
    },
    "levelRewards": [
      {
        "level": 2,
        "rewards": [
          { "type": "money", "amount": 100 },
          { "type": "unlock", "id": "basic_fertilizer" }
        ],
        "message": "You can now buy fertilizer!"
      },
      {
        "level": 3,
        "rewards": [
