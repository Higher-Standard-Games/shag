        "message": "Downtown district unlocked!"
      },
      {
        "level": 25,
        "rewards": [
          { "type": "money", "amount": 25000 },
          { "type": "title", "id": "expert_breeder" }
        ],
        "message": "Expert Breeder title earned!"
      },
      {
        "level": 30,
        "rewards": [
          { "type": "money", "amount": 50000 },
          { "type": "unlock", "id": "dispensary_license" }
        ],
        "message": "Dispensary license unlocked!"
      },
      {
        "level": 40,
        "rewards": [
          { "type": "money", "amount": 100000 },
          { "type": "title", "id": "cannabis_tycoon" }
        ],
        "message": "Cannabis Tycoon!"
      },
      {
        "level": 50,
        "rewards": [
          { "type": "money", "amount": 500000 },
          { "type": "title", "id": "legend" },
          { "type": "unlock", "id": "golden_seeds" }
        ],
        "message": "LEGENDARY! You've mastered the game!"
      }
