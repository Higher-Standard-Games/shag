{
  "commands": [
    {
      "name": "help",
      "description": "Show available commands",
      "usage": "help [command]"
    },
    {
      "name": "show_fps",
      "description": "Toggle FPS/performance metrics display (0=off, 1=on)",
      "usage": "show_fps <0|1>"
    },
    {
      "name": "freefly_speed",
      "description": "Get or set freefly camera speed",
      "usage": "freefly_speed [speed]"
    },
    {
      "name": "freefly_collision",
      "description": "Toggle collision detection in freefly mode (0=off, 1=on)",
      "usage": "freefly_collision [0|1|mode|test|draw|clear|clipviz|clipdump|cliptrace]",
      "subcommands": [
        { "name": "mode", "description": "Get/set collision mode", "args": ["native|bsp?"] },
        { "name": "test", "description": "Trace forward from camera and print result" },
        { "name": "draw", "description": "Draw trace + hit normal in the scene", "args": ["dist?", "normalLen?", "radius?", "height?"] },
        { "name": "clear", "description": "Clear collision visualization meshes" },
        { "name": "clipviz", "description": "Visualize clip brushes (fullclip/playerclip) as wireframes", "args": ["off|clear|last|brush <index>|<max>?", "max?"] },
        { "name": "clipdump", "description": "Dump brush sides/planes for a clip brush", "args": ["last|brush <index>|<index>"] },
        { "name": "cliptrace", "description": "Trace against clip brushes only (for debugging)", "args": ["dist?", "radius?", "height?", "debug?"] }
      ]
    },
    {
      "name": "bsp",
      "description": "BSP map loading and debugging (Quake3/Warsow FBSP)",
      "usage": "bsp <command> [args]",
      "subcommands": [
        { "name": "load", "description": "Load BSP from PK3", "args": ["mapname"] },
        { "name": "info", "description": "Show loaded BSP statistics" },
        { "name": "entities", "description": "List entities in BSP", "args": ["filter?"] },
        { "name": "textures", "description": "List textures in BSP", "args": ["limit?"] },
        { "name": "render", "description": "Render BSP to scene" },
        { "name": "clear", "description": "Clear rendered BSP geometry" },
        { "name": "faces", "description": "Show face type breakdown" },
        { "name": "clusters", "description": "Show PVS cluster info" },
        { "name": "lightmaps", "description": "Show lightmap info" },
        { "name": "worldspawn", "description": "Show worldspawn properties" },
        { "name": "fog", "description": "Fog volume commands (info, apply, clear)" },
        { "name": "collision", "description": "Collision detection commands (trace, backend, test)" },
        { "name": "sky", "description": "Skybox commands (info, apply, toggle)" },
        { "name": "applytextures", "description": "Load and apply textures from PK3" },
        { "name": "applylightmaps", "description": "Apply lightmaps to rendered geometry" }
      ]
    },
    {
      "name": "shader",
      "description": "Q3/Warsow shader debugging utilities",
      "usage": "shader <command> [args]",
      "subcommands": [
        { "name": "load", "description": "Load shaders from PK3" },
        { "name": "count", "description": "Show loaded shader count" },
        { "name": "list", "description": "List shader names", "args": ["filter?"] },
        { "name": "info", "description": "Show shader definition (or aimed surface when no path)", "args": ["texture_path?"] },
        { "name": "aim", "description": "Toggle aimed-surface highlight (edges)", "args": ["0|1"] },
        { "name": "resolve", "description": "Show resolved material props", "args": ["texture_path"] },
        { "name": "pattern", "description": "Analyze shader pattern", "args": ["texture_path"] },
        { "name": "deps", "description": "Debug shader/texture dependencies", "args": ["texture_path"] },
        { "name": "glow", "description": "Set glow intensity", "args": ["intensity"] },
        { "name": "lightmap", "description": "Set lightmap intensity", "args": ["intensity"] },
        { "name": "blendmode", "description": "Toggle glow blend mode", "args": ["add|alpha"] },
        { "name": "clear", "description": "Clear shader registry" },
        { "name": "anim", "description": "Shader animation system commands", "args": ["..."] }
      ]
    },
    {
      "name": "clear",
      "description": "Clear console output",
      "usage": "clear"
    },
    {
      "name": "version",
      "description": "Show engine version",
      "usage": "version"
    },
    {
      "name": "camera",
      "description": "Camera controls",
      "usage": "camera <command> [args]",
      "subcommands": [
        { "name": "mode", "description": "Set camera mode", "args": ["perspective|orthographic|fake_ortho"] },
        { "name": "height", "description": "Set camera height", "args": ["number"] },
        { "name": "pos", "description": "Set camera position", "args": ["x", "y", "z"] },
        { "name": "target", "description": "Set camera target", "args": ["x", "y", "z"] },
        { "name": "reset", "description": "Reset camera to default" },
        { "name": "controller", "description": "Switch camera controller", "args": ["isometric|fps|sidescroll"] },
        { "name": "controllers", "description": "List available controllers" },
        { "name": "info", "description": "Show current camera info" },
        { "name": "preset", "description": "Apply camera preset", "args": ["presetname"] },
        { "name": "presets", "description": "List available presets" }
      ]
    },
    {
      "name": "audio",
      "description": "Audio controls",
      "usage": "audio <command> [args]",
      "subcommands": [
        { "name": "volume", "description": "Set music volume", "args": ["0-1"] },
        { "name": "mute", "description": "Mute all audio" },
        { "name": "unmute", "description": "Unmute audio" },
        { "name": "play", "description": "Play music track", "args": ["trackname"] },
        { "name": "stop", "description": "Stop music" }
      ]
    },
    {
      "name": "time",
      "description": "Game clock controls",
      "usage": "time <command> [args]",
      "subcommands": [
        { "name": "set", "description": "Set time of day", "args": ["hour"] },
        { "name": "speed", "description": "Set time speed multiplier", "args": ["multiplier"] },
        { "name": "pause", "description": "Pause time" },
        { "name": "resume", "description": "Resume time" }
      ]
    },
    {
      "name": "debug",
      "description": "Debug utilities",
      "usage": "debug <command>",
      "subcommands": [
        { "name": "fps", "description": "Toggle FPS display" },
        { "name": "wireframe", "description": "Toggle wireframe mode" },
        { "name": "bounds", "description": "Toggle bounding boxes" },
        { "name": "lights", "description": "Toggle light gizmos" }
      ]
    },
    {
      "name": "map",
      "description": "Map commands",
      "usage": "map <command> [args]",
      "subcommands": [
        { "name": "load", "description": "Load a map", "args": ["mapname"] },
        { "name": "reload", "description": "Reload current map" },
        { "name": "list", "description": "List available maps" }
      ]
    },
    {
      "name": "weather",
      "description": "Control weather effects",
      "usage": "weather <type> [intensity]",
      "subcommands": [
        { "name": "rain", "description": "Start rain", "args": ["intensity?"] },
        { "name": "snow", "description": "Start snow", "args": ["intensity?"] },
        { "name": "clear", "description": "Clear weather" },
        { "name": "fog", "description": "Set fog", "args": ["density?"] },
        { "name": "thunder", "description": "Trigger thunder" },
        { "name": "status", "description": "Show weather status" }
      ]
    },
    {
      "name": "wind",
      "description": "Control wind system",
      "usage": "wind <command> [args]",
      "subcommands": [
        { "name": "on", "description": "Start wind" },
        { "name": "off", "description": "Stop wind" },
        { "name": "strength", "description": "Set wind strength", "args": ["0-1"] },
        { "name": "angle", "description": "Set wind angle", "args": ["radians"] },
        { "name": "gust", "description": "Trigger a wind gust" },
        { "name": "calm", "description": "Calm breeze preset" },
        { "name": "moderate", "description": "Moderate wind preset" },
        { "name": "storm", "description": "Storm wind preset" }
      ]
    },
    {
      "name": "debris",
      "description": "Control flying debris particles",
      "usage": "debris <type>",
      "subcommands": [
        { "name": "leaves", "description": "Start leaves debris" },
        { "name": "trash", "description": "Start trash/paper debris" },
        { "name": "dust", "description": "Start dust particles" },
        { "name": "mixed", "description": "Start mixed debris" },
        { "name": "off", "description": "Stop debris" },
        { "name": "density", "description": "Set debris density", "args": ["0-1"] }
      ]
    },
    {
      "name": "export",
      "description": "Export settings to JSON or NetRadiant format",
      "usage": "export <target>",
      "subcommands": [
        { "name": "camera", "description": "Export camera settings (JSON)" },
        { "name": "fx", "description": "Export post-processing settings (JSON)" },
        { "name": "all", "description": "Export all settings (JSON)" },
        { "name": "map", "description": "Export worldspawn values for NetRadiant" },
        { "name": "show", "description": "Preview settings without copying" }
      ]
    },
    {
      "name": "pvs",
      "description": "PVS (Potentially Visible Set) culling control",
      "usage": "pvs <command>",
      "subcommands": [
        { "name": "on", "description": "Enable PVS culling" },
        { "name": "off", "description": "Disable PVS culling" },
        { "name": "status", "description": "Show PVS culling stats" },
        { "name": "cluster", "description": "Show current cluster info" },
        { "name": "debug", "description": "Toggle debug visualization" }
      ]
    }
  ]
}
