{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "New Game Configuration",
  "description": "Starting values for a new game",
  "type": "object",
  "properties": {
    "startingMoney": {
      "type": "integer",
      "description": "Starting money for the player",
      "minimum": 0
    },
    "startingArea": {
      "type": "string",
      "description": "ID of the starting area"
    },
    "startingLot": {
      "type": "string",
      "description": "ID of the starting lot the player owns"
    },
    "startingUnlocks": {
      "type": "array",
      "description": "IDs of items/features unlocked at start",
      "items": {
        "type": "string"
      }
    },
    "startingInventory": {
      "type": "array",
      "description": "Items the player starts with",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Item ID"
          },
          "type": {
            "type": "string",
            "enum": ["seed", "fertilizer", "harvest", "equipment", "consumable", "material", "special"],
            "description": "Item type"
          },
          "quantity": {
            "type": "integer",
            "description": "Quantity of the item",
            "minimum": 1
          }
        },
        "required": ["id", "type", "quantity"]
      }
    },
    "startingBarrel": {
      "type": "object",
      "description": "Free starter curing barrel",
      "properties": {
        "templateId": {
          "type": "string",
          "description": "Barrel template ID"
        }
      },
      "required": ["templateId"]
    }
  },
  "required": ["startingMoney", "startingArea", "startingLot", "startingUnlocks", "startingInventory"]
}
