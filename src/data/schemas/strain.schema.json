{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Strain Genetics Data",
  "description": "Schema for plant strain genetics definitions",
  "type": "object",
  "required": ["strains"],
  "properties": {
    "strains": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Strain"
      }
    }
  },
  "definitions": {
    "Strain": {
      "type": "object",
      "required": [
        "id", "name", "description", "type", "indicaPercent",
        "thcContent", "cbdContent", "effects", "negativeEffects",
        "flavors", "terpenes", "growthTraits", "appearance",
        "lineage", "rarity", "basePrice", "isLandrace",
        "tier", "specialTraits", "unlockLevel"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the strain",
          "pattern": "^genetics_[a-z0-9_]+$"
        },
        "name": {
          "type": "string",
          "description": "Display name of the strain"
        },
        "description": {
          "type": "string",
          "description": "Flavor text description"
        },
        "type": {
          "type": "string",
          "enum": ["indica", "sativa", "hybrid"],
          "description": "Primary strain type"
        },
        "indicaPercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Percentage of indica genetics (0-100)"
        },
        "thcContent": {
          "type": "number",
          "minimum": 0,
          "maximum": 35,
          "description": "THC percentage"
        },
        "cbdContent": {
          "type": "number",
          "minimum": 0,
          "maximum": 20,
          "description": "CBD percentage"
        },
        "effects": {
          "type": "object",
          "description": "Positive effects with intensity (0-100)",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "negativeEffects": {
          "type": "object",
          "description": "Negative effects with intensity (0-100)",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "flavors": {
          "type": "object",
          "description": "Flavor profile with intensity (0-100)",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "terpenes": {
          "type": "object",
          "description": "Terpene profile with intensity (0-100)",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "growthTraits": {
          "$ref": "#/definitions/GrowthTraits"
        },
        "appearance": {
          "$ref": "#/definitions/AppearanceTraits"
        },
        "lineage": {
          "$ref": "#/definitions/Lineage"
        },
        "rarity": {
          "type": "string",
          "enum": ["common", "uncommon", "rare", "legendary", "unique"]
        },
        "basePrice": {
          "type": "number",
          "minimum": 0,
          "description": "Base price per gram"
        },
        "isLandrace": {
          "type": "boolean",
          "description": "True if this is an original landrace strain"
        },
        "tier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Genetic tier (1-5)"
        },
        "specialTraits": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "auto_flower", "high_thc", "high_cbd", "fast_flower",
              "heavy_yield", "purple_pheno", "frost_giant", "pest_immune",
              "drought_master", "compact_growth", "giant_growth",
              "exotic_flavor", "balanced_hybrid", "medicinal", "connoisseur"
            ]
          },
          "description": "Special genetic traits"
        },
        "unlockLevel": {
          "type": "integer",
          "minimum": 1,
          "description": "Player level required to obtain seeds"
        },
        "environment": {
          "$ref": "#/definitions/Environment"
        },
        "gameplay": {
          "$ref": "#/definitions/Gameplay"
        }
      }
    },
    "Environment": {
      "type": "object",
      "required": ["lightIntensity", "humidityMin", "humidityMax", "potSize", "nutrientDemand"],
      "properties": {
        "lightIntensity": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "description": "Preferred light intensity"
        },
        "humidityMin": {
          "type": "integer",
          "minimum": 20,
          "maximum": 80,
          "description": "Minimum humidity %"
        },
        "humidityMax": {
          "type": "integer",
          "minimum": 20,
          "maximum": 80,
          "description": "Maximum humidity %"
        },
        "potSize": {
          "type": "string",
          "enum": ["small", "medium", "large"],
          "description": "Preferred pot size"
        },
        "nutrientDemand": {
          "type": "string",
          "enum": ["light", "medium", "heavy"],
          "description": "Nutrient demand level"
        }
      }
    },
    "Gameplay": {
      "type": "object",
      "required": [
        "growthTime", "stages", "waterConsumption", "baseYield",
        "xpReward", "seedId", "harvestId", "curedId"
      ],
      "properties": {
        "growthTime": {
          "type": "integer",
          "minimum": 1000,
          "description": "Total growth time in milliseconds"
        },
        "stages": {
          "type": "integer",
          "minimum": 3,
          "maximum": 10,
          "description": "Number of growth stages"
        },
        "waterConsumption": {
          "type": "number",
          "minimum": 0,
          "description": "Water consumed per minute"
        },
        "baseYield": {
          "type": "integer",
          "minimum": 1,
          "description": "Base harvest yield in grams"
        },
        "xpReward": {
          "type": "integer",
          "minimum": 1,
          "description": "XP reward for harvesting"
        },
        "seedId": {
          "type": "string",
          "description": "Item ID for seeds"
        },
        "harvestId": {
          "type": "string",
          "description": "Item ID for fresh harvest"
        },
        "curedId": {
          "type": "string",
          "description": "Item ID for cured product"
        },
        "harvestWindow": {
          "type": "integer",
          "description": "Time window for perfect harvest in ms"
        },
        "overripeTime": {
          "type": "integer",
          "description": "Time until overripe in ms"
        },
        "preferredTempMin": {
          "type": "integer",
          "description": "Minimum preferred temperature in °F"
        },
        "preferredTempMax": {
          "type": "integer",
          "description": "Maximum preferred temperature in °F"
        },
        "waterPromptInterval": {
          "type": "integer",
          "description": "Interval between water prompts in ms"
        },
        "waterPromptWindow": {
          "type": "integer",
          "description": "Time window to respond to water prompt in ms"
        },
        "curingTime": {
          "type": "integer",
          "description": "Time to cure harvest in ms"
        },
        "seedDropChance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Chance to drop seeds on harvest"
        },
        "rareSeedDrops": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "strainId": { "type": "string" },
              "chance": { "type": "number" }
            }
          }
        },
        "fertilization": {
          "$ref": "#/definitions/Fertilization"
        }
      }
    },
    "Fertilization": {
      "type": "object",
      "required": ["requiredApplications", "fertilizerType", "applicationTiming"],
      "properties": {
        "requiredApplications": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "description": "Number of fertilizer applications needed for 100% yield"
        },
        "fertilizerType": {
          "type": "string",
          "enum": ["basic", "premium", "advanced"],
          "description": "Type of fertilizer required"
        },
        "applicationTiming": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": "Growth progress % when to apply fertilizer (e.g., [0.25, 0.5, 0.75])"
        }
      }
    },
    "GrowthTraits": {
      "type": "object",
      "required": [
        "floweringTime", "yieldPotential", "heightPotential",
        "difficulty", "moldResistance", "pestResistance", "droughtTolerance"
      ],
      "properties": {
        "floweringTime": {
          "type": "integer",
          "minimum": 30,
          "maximum": 120,
          "description": "Days to flower (game days)"
        },
        "yieldPotential": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Yield potential (0-100)"
        },
        "heightPotential": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Height potential (0-100, short to tall)"
        },
        "difficulty": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Growing difficulty (0-100)"
        },
        "moldResistance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Mold resistance (0-100)"
        },
        "pestResistance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Pest resistance (0-100)"
        },
        "droughtTolerance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Drought tolerance (0-100)"
        }
      }
    },
    "AppearanceTraits": {
      "type": "object",
      "required": ["budDensity", "trichomeCoverage", "purpleExpression", "orangeHairs"],
      "properties": {
        "budDensity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "trichomeCoverage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "purpleExpression": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "orangeHairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "Lineage": {
      "type": "object",
      "required": ["generation", "isStabilized"],
      "properties": {
        "parent1Id": {
          "type": "string",
          "description": "Mother strain ID"
        },
        "parent2Id": {
          "type": "string",
          "description": "Father strain ID"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "description": "Generation (0 = landrace, 1 = F1, etc.)"
        },
        "isStabilized": {
          "type": "boolean",
          "description": "True if bred for consistency"
        },
        "breederName": {
          "type": "string",
          "description": "Who created this strain"
        },
        "originRegion": {
          "type": "string",
          "description": "Geographic origin for landraces"
        }
      }
    }
  }
}
