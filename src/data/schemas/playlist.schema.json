{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Music Playlist",
  "description": "Playlist configuration for in-game music",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name of the playlist"
    },
    "loop": {
      "type": "boolean",
      "description": "Whether to loop the playlist when it ends",
      "default": true
    },
    "shuffle": {
      "type": "boolean",
      "description": "Whether to shuffle track order",
      "default": false
    },
    "tracks": {
      "type": "array",
      "description": "List of tracks in the playlist",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "description": "Filename of the audio file (in assets/audio/music/)"
          },
          "title": {
            "type": "string",
            "description": "Display title of the track"
          }
        },
        "required": ["file"]
      },
      "minItems": 1
    }
  },
  "required": ["tracks"]
}
