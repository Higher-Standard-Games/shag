{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Game Configuration",
  "description": "Platform-specific display and behavior settings",
  "type": "object",
  "properties": {
    "display": {
      "type": "object",
      "description": "General display settings",
      "properties": {
        "orientation": {
          "type": "string",
          "enum": ["landscape", "portrait", "any"],
          "default": "landscape",
          "description": "Preferred screen orientation"
        },
        "fullscreen": {
          "type": "boolean",
          "default": true,
          "description": "Run in fullscreen mode on mobile"
        },
        "keepScreenAwake": {
          "type": "boolean",
          "default": true,
          "description": "Prevent screen from sleeping during gameplay"
        }
      }
    },
    "android": {
      "type": "object",
      "description": "Android-specific settings",
      "properties": {
        "screenOrientation": {
          "type": "string",
          "enum": ["landscape", "portrait", "sensorLandscape", "sensorPortrait", "unspecified"],
          "default": "landscape"
        },
        "immersiveMode": {
          "type": "boolean",
          "default": true,
          "description": "Hide system UI for immersive experience"
        }
      }
    },
    "ios": {
      "type": "object",
      "description": "iOS-specific settings",
      "properties": {
        "screenOrientation": {
          "type": "string",
          "enum": ["landscape", "portrait", "all"],
          "default": "landscape"
        },
        "statusBarHidden": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
