{
  "name": "isometric-game-prototype",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:textures": "node scripts/convert-ktx2.js",
    "build:textures:clean": "node scripts/convert-ktx2.js --clean",
    "build:prod": "npm run build:textures && npm run build",
    "preview": "vite preview",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "check": "biome check --write ./src",
    "test": "vitest",
    "test:run": "vitest run",
    "cap:sync": "npx cap sync",
    "android:build": "npm run build && npx cap sync android",
    "android:open": "node scripts/android-open.cjs",
    "android:run": "npx cap run android",
    "android:live": "npm run build && npx cap sync android && npx cap run android --livereload --external"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "jsdom": "^27.2.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@babylonjs/core": "^8.42.0",
    "@babylonjs/loaders": "^8.42.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "babylonjs": "^8.42.0",
    "babylonjs-loaders": "^8.42.0"
  }
}
