{
  "name": "shag-engine",
  "private": true,
  "version": "0.9.31",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "dev": "vite",
    "prebuild": "npm run tools:pk3-index",
    "build": "tsc && vite build",
    "postbuild": "node scripts/relocate-sourcemaps.mjs",
    "build:prod": "npm run tools:textures && npm run build",
    "preview": "vite preview",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "check": "biome check --write ./src",
    "prepare": "git config core.hooksPath .githooks",
    "gate:biome": "node scripts/biome-gate.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "cli:game": "npx vite-node src/cli/headless-game.ts --",
    "cli:bsp": "npx vite-node src/cli/headless-bsp.ts --",
    "net:server": "node dist-server/headless-netserver-v2.mjs --",
    "net:client": "npx vite-node src/cli/headless-netclient.ts --",
    "lobby:server": "node dist-server/lobby-server.mjs --",
    "ranking:simulate": "npx vite-node src/cli/ranking-simulate.ts",
    "ranking:delivery": "npx vite-node src/cli/ranking-delivery.ts --",
    "ranking:acceptance": "vitest run src/shared/ranking src/lobby src/engine/server/network/__tests__/MatchResultReport.test.ts src/engine/server/network/__tests__/MatchAdmission.test.ts src/bot/__tests__/BotLobbyReference.test.ts src/bot/__tests__/BotServerControlAuth.test.ts src/games/fps/server/__tests__/PlayedMatchResult.test.ts src/games/fps/client/__tests__/LeaderboardView.test.ts src/games/fps/client/__tests__/NewUiApiLeaderboard.test.ts src/games/fps/client/__tests__/ProfileRecord.test.ts",
    "shagged": "npx vite-node src/cli/shagged.ts --",
    "shagged:mcp": "node scripts/shagged-mcp.mjs",
    "shagged:server": "npx vite-node src/cli/shagged-server.ts --",
    "shagged:compile": "npx vite-node src/cli/shagged-compile.ts --",
    "bot:server": "npx vite-node src/cli/bot-server.ts --",
    "bot:analyze": "vite-node src/cli/bot-analyze.ts",
    "bot:learn": "vite-node src/cli/bot-learn.ts --",
    "bot:train": "npx vite-node src/cli/bot-train.ts --",
    "bot:bench": "npx vite-node src/cli/bot-bench.ts --",
    "server:tick": "npx vite-node src/cli/server-tick.ts",
    "server:game": "npx vite-node src/cli/server-game.ts",
    "server:fuzz": "npx vite-node src/cli/server-fuzz.ts --",
    "debug:textures": "npx vite-node src/cli/audit-textures.ts --",
    "debug:compare": "npx vite-node src/cli/compare-local-vs-server.ts --",
    "debug:collision": "npx vite-node src/cli/debug-collision-gravity.ts --",
    "debug:pickup": "npx vite-node src/cli/debug-pickup-full.ts --",
    "debug:spawn": "npx vite-node src/cli/test-spawn.ts --",
    "test:simulation": "npx vite-node src/cli/test-fps-simulation.ts",
    "test:physics": "npx vite-node src/cli/test-server-physics.ts",
    "test:lifts": "npx vite-node src/cli/test-lifts.ts",
    "net:viewlag": "npx vite-node src/cli/measure-viewlag.ts",
    "audit:pvs": "npx vite-node src/cli/audit-pvs.ts --",
    "audit:stuck": "npx vite-node src/cli/audit-stuck.ts --",
    "tools:convert": "npx vite-node src/cli/convert-fbx.ts --",
    "tools:player-model": "node scripts/package-player-model.mjs",
    "tools:weapon-models": "node scripts/package-weapon-models.mjs",
    "convert:weapons": "node scripts/convert-weapon-models.mjs",
    "tools:fbx2gltf": "npx vite-node scripts/download-fbx2gltf.ts",
    "tools:textures": "node scripts/convert-ktx2.js",
    "tools:textures:audit": "node scripts/convert-ktx2.js --dry-run",
    "tools:textures:clean": "node scripts/convert-ktx2.js --clean",
    "tools:optimize": "gltf-transform optimize --texture-compress webp --compress meshopt",
    "tools:manifest": "node scripts/generate-pk3-manifest.js",
    "tools:pk3-index": "node scripts/generate-pk3-index.mjs",
    "tools:map": "npx vite-node src/tools/generate-map.ts",
    "dev:agents": "node --experimental-strip-types scripts/dev-agents.ts",
    "dev:agents:list": "node --experimental-strip-types scripts/dev-agents.ts list",
    "dev:research:agents-list": "node --experimental-strip-types scripts/dev-agents.ts list",
    "dev:research": "node --experimental-strip-types scripts/dev-agents.ts research",
    "dev:research:doc": "node --experimental-strip-types scripts/dev-agents.ts default-research --doc=\"$npm_config_doc\" --goal=\"$npm_config_goal\" --title=\"$npm_config_title\" --risk=\"$npm_config_risk\" --out-dir=\"$npm_config_out_dir\" --timeout-ms=\"$npm_config_timeout_ms\" --dry-run=\"$npm_config_dry_run\"",
    "dev:research:wizard": "node --experimental-strip-types scripts/research-wizard.ts --doc=\"$npm_config_doc\" --goal=\"$npm_config_goal\" --timeout-ms=\"$npm_config_timeout_ms\" --dry-run=\"$npm_config_dry_run\" --create-new=\"$npm_config_create_new\" --filename=\"$npm_config_filename\" --about=\"$npm_config_about\"",
    "dev:task": "node --experimental-strip-types scripts/dev-agents.ts task",
    "dev:task:init": "node --experimental-strip-types scripts/dev-agents.ts init-task",
    "docs:api": "node scripts/build-docs.js",
    "docs:dev": "vitepress dev docs/manual",
    "docs:build": "vitepress build docs/manual",
    "docs:preview": "vitepress preview docs/manual",
    "docs:fps:dev": "vitepress dev src/games/fps/docs/manual",
    "docs:fps:build": "vitepress build src/games/fps/docs/manual",
    "docs:fps:preview": "vitepress preview src/games/fps/docs/manual",
    "cap:sync": "npx cap sync",
    "android:build": "npm run build && npx cap sync android",
    "android:open": "node scripts/android-open.cjs",
    "android:run": "npx cap run android",
    "android:live": "npm run build && npx cap sync android && npx cap run android --livereload --external",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && npm run electron:compile && electron-builder --config electron-builder.config.cjs",
    "electron:compile": "tsc -p tsconfig.electron.json && node -e \"const fs=require('fs');['main','preload'].forEach(f=>{const src='dist-electron/'+f+'.js',dst='dist-electron/'+f+'.cjs';if(fs.existsSync(src)){fs.renameSync(src,dst);fs.existsSync(src+'.map')&&fs.renameSync(src+'.map',dst+'.map')}})\"",
    "electron:preview": "npm run build && npm run electron:compile && electron .",
    "demo:record": "npx vite-node src/cli/record-demo.ts --",
    "benchmark:fixture": "node scripts/benchmarks/create-fixture.mjs",
    "benchmark:profile": "node scripts/benchmarks/profile-timedemo.mjs",
    "benchmark:outlines": "node scripts/benchmarks/outline-comparison.mjs",
    "benchmark:crowd": "node scripts/benchmarks/crowd-benchmark.mjs",
    "benchmark:outline-proxy:build": "node scripts/benchmarks/build-outline-proxy.mjs",
    "demo:verify": "npx vite-node src/cli/demo-verify.ts --",
    "anticheat:calibrate": "npx vite-node src/cli/anticheat-calibrate.ts --",
    "deps:babylon": "node scripts/babylon-deps.mjs",
    "build:server": "node scripts/build-servers.mjs",
    "prelobby:server": "npm run build:server",
    "prenet:server": "npm run build:server",
    "lobby:server:node": "node dist-server/lobby-server.mjs --",
    "net:server:node": "node dist-server/headless-netserver-v2.mjs --",
    "prelobby:server:node": "npm run build:server",
    "prenet:server:node": "npm run build:server",
    "lobby:server:bun": "bun dist-server/lobby-server.mjs --",
    "net:server:bun": "bun dist-server/headless-netserver-v2.mjs --",
    "lobby:server:dev": "npx vite-node src/cli/lobby-server.ts --",
    "net:server:dev": "npx vite-node src/cli/headless-netserver-v2.ts --",
    "benchmark:server-memory": "node scripts/benchmarks/server-memory.mjs",
    "prelobby:server:bun": "npm run build:server",
    "prenet:server:bun": "npm run build:server",
    "test:runtime-equivalence": "node scripts/benchmarks/runtime-equivalence.mjs",
    "test:server-runtime": "npm run build:server && bun dist-server/ServerRuntimeProbe.mjs"
  },
  "devDependencies": {
    "@babylonjs/ktx2decoder": "9.17.0",
    "@babylonjs/materials": "9.17.0",
    "@biomejs/biome": "^2.3.8",
    "@fails-components/webtransport": "^1.5.2",
    "@gltf-transform/cli": "^4.3.0",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "3.2.4",
    "babylonjs-gltf2interface": "9.17.0",
    "concurrently": "^9.2.1",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "jpeg-js": "0.4.4",
    "jsdom": "^28.1.0",
    "mermaid": "^11.17.2",
    "rollup-plugin-visualizer": "^7.0.0",
    "typedoc": "^0.28.15",
    "typescript": "^5.2.2",
    "vite": "^6.3.5",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^3.2.3",
    "wait-on": "^9.0.4",
    "ws": "^8.19.0",
    "esbuild": "0.25.12"
  },
  "dependencies": {
    "@2toad/profanity": "3.3.0",
    "@babylonjs/core": "^9.17.0",
    "@babylonjs/havok": "^1.3.13",
    "@babylonjs/loaders": "^9.17.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@tensorflow/tfjs-node": "^4.22.0",
    "jszip": "^3.10.1",
    "pngjs": "^7.0.0",
    "ts-trueskill": "5.1.0"
  }
}
