{
  "name": "shag-engine",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs');const src='node_modules/@babylonjs/havok/lib/esm/HavokPhysics.wasm';const dest='public/wasm/HavokPhysics.wasm';if(fs.existsSync(src)){fs.mkdirSync('public/wasm',{recursive:true});fs.copyFileSync(src,dest);console.log('Copied HavokPhysics.wasm to public/wasm/')}\"",
    "dev": "vite",
    "build": "tsc && vite build",
    "build:textures": "node scripts/convert-ktx2.js",
    "build:textures:clean": "node scripts/convert-ktx2.js --clean",
    "build:prod": "npm run build:textures && npm run build",
    "preview": "vite preview",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "check": "biome check --write ./src",
    "test": "vitest",
    "test:run": "vitest run",
    "cap:sync": "npx cap sync",
    "android:build": "npm run build && npx cap sync android",
    "android:open": "node scripts/android-open.cjs",
    "android:run": "npx cap run android",
    "android:live": "npm run build && npx cap sync android && npx cap run android --livereload --external",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && npm run electron:compile && electron-builder --config electron-builder.config.js",
    "electron:compile": "tsc -p tsconfig.electron.json && node -e \"const fs=require('fs');['main','preload'].forEach(f=>{const src='dist-electron/'+f+'.js',dst='dist-electron/'+f+'.cjs';if(fs.existsSync(src)){fs.renameSync(src,dst);fs.existsSync(src+'.map')&&fs.renameSync(src+'.map',dst+'.map')}})\"",
    "electron:preview": "npm run build && npm run electron:compile && electron .",
    "generate:map": "npx vite-node src/tools/generate-map.ts",
    "generate:test": "npx vite-node src/tools/test-generator.ts",
    "cli:game": "npx vite-node src/cli/headless-game.ts --",
    "cli:bsp": "npx vite-node src/cli/headless-bsp.ts --",
    "net:server": "npx vite-node src/cli/headless-netserver-v2.ts --",
    "net:client": "npx vite-node src/cli/headless-netclient.ts --",
    "docs:api": "node scripts/build-docs.js",
    "docs:dev": "vitepress dev docs/manual",
    "docs:build": "vitepress build docs/manual",
    "docs:preview": "vitepress preview docs/manual",
    "tools:fbx2gltf": "npx vite-node scripts/download-fbx2gltf.ts",
    "server:tick": "npx vite-node src/cli/server-tick.ts",
    "server:protocol": "npx vite-node src/cli/server-protocol.ts",
    "server:replay": "npx vite-node src/cli/server-replay.ts",
    "server:bench": "npx vite-node src/cli/server-bench.ts",
    "server:game": "npx vite-node src/cli/server-game.ts",
    "server:fuzz": "npx vite-node src/cli/server-fuzz.ts --",
    "server:integration": "npx vite-node src/cli/server-integration.ts --"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@fails-components/webtransport": "^1.5.2",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.1",
    "concurrently": "^8.2.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^27.2.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "typedoc": "^0.28.15",
    "typescript": "^5.2.2",
    "vite": "^5.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^1.6.0",
    "wait-on": "^7.2.0",
    "ws": "^8.19.0"
  },
  "dependencies": {
    "@babylonjs/core": "^8.44.1",
    "@babylonjs/havok": "^1.3.11",
    "@babylonjs/loaders": "^8.44.1",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "jszip": "^3.10.1",
    "pngjs": "^7.0.0"
  }
}