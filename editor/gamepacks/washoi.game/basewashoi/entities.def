// =============================================================================
//  RAW-.MAP PATH ONLY  (src/engine/MapRenderer.ts)
//
//  These are read by the raw map renderer, NOT by the compiled-BSP gameplay
//  path. They are kept here so the raw/preview workflow stays usable, clearly
//  separated from the gameplay classes above. Placing them in a compiled map
//  has no gameplay effect.
// =============================================================================
/*QUAKED misc_model (.5 .5 .5) (-16 -16 -16) (16 16 32) ?
  -------- KEYS --------
  origin: Position
  model: Model / Prefab Path
  angle: Y Rotation (default: 0)
  scale: Uniform Scale (default: 1)
  collision: Collision (default: 1)
  receiveShadows: Receive Shadows (default: 1)
  castShadows: Cast Shadows (default: 0)
  visible: Visible (default: 1)
  renderingGroup: Rendering Group (default: 0)
  dropToGround: Drop To Ground (default: 0)
  dropOffset: Drop Offset (default: 0)
*/

/*QUAKED street_lamp (.5 .5 .5) (-16 -16 -16) (16 16 32) ?
  -------- KEYS --------
  origin: Position
  targetname: Target Name
  light: Max Intensity (default: 200)
  range: Range (default: 100)
  _color: Color (default: 255 200 150)
  fadeTime: Fade Time (s) (default: 2)
  turnOnHour: Turn On Hour (default: 18)
  turnOffHour: Turn Off Hour (default: 6)
  flicker: Flicker (default: 0)
  showBulb: Show Bulb (default: 1)
  bulbSize: Bulb Size (default: 3)
*/

