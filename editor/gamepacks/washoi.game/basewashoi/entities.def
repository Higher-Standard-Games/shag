// -----------------------------------------------------------------------------
//  TRIGGERS  (brush entities -- texture every face with textures/common/trigger)
//
//  The volume is BSP submodel *N's AABB. "model" and "target" are both
//  mandatory; a trigger missing either is dropped silently at load.
//  These have NO origin -- the submodel AABB is the volume.
// -----------------------------------------------------------------------------
/*QUAKED trigger_teleport (1 .5 0) ?
  -------- KEYS --------
  model: Submodel (*N) -- required
  target: Target Entity -- required
*/

/*QUAKED trigger_push (1 .5 0) ?
  -------- KEYS --------
  model: Submodel (*N) -- required
  target: Target Entity -- required
*/

// Lift callers. NOTE: the engine computes AABB = submodel AABB + origin, so
// leave origin at "0 0 0" or you will double-count the offset.
/*QUAKED trigger_once (1 .5 0) ?
  -------- KEYS --------
  model: Submodel (*N) -- required
  target: Target Name -- required
  origin: Offset -- leave 0 0 0
  wait: Hold Time (s) (default: 0.5)
*/

/*QUAKED trigger_multiple (1 .5 0) ?
  -------- KEYS --------
  model: Submodel (*N) -- required
  target: Target Name -- required
  origin: Offset -- leave 0 0 0
  wait: Hold Time (s) (default: 0.5)
*/

/*QUAKED func_button (0 .5 .8) ?
  -------- KEYS --------
  model: Submodel (*N) -- required
  target: Target Name -- required
  origin: Offset -- leave 0 0 0
  wait: Hold Time (s) (default: 1)
*/

/*QUAKED trigger_hurt (1 .5 0) ? NOTOUCH
  -------- KEYS --------
  model: Submodel (*N) -- required
  target: Target Name
  origin: Offset -- leave 0 0 0
  dmg: Damage (default: 5)
  wait: Hold Time (s) (default: 0.2)
*/

// -----------------------------------------------------------------------------
//  TRIGGER TARGETS  (point entities)
//
//  TriggerTable resolves target -> targetname against this allow-list only.
//  A trigger pointing at any other classname is dropped with a console
//  warning, so if your teleporter does nothing, check this list first.
//  "G_PickTarget" itself does not filter by classname -- this is a safety
//  allow-list, and it must stay a superset of what your maps use.
// -----------------------------------------------------------------------------
/*QUAKED target_position (.5 .5 0) (-16 -16 -16) (16 16 32) ?
  -------- KEYS --------
  origin:
  targetname:
*/

/*QUAKED target_location (.5 .5 0) (-16 -16 -16) (16 16 32) ?
  -------- KEYS --------
  origin:
  targetname:
*/

/*QUAKED misc_teleporter_dest (.5 .5 .5) (-16 -16 -16) (16 16 32) ?
  -------- KEYS --------
  origin:
  angle:
  targetname:
*/

/*QUAKED info_teleport_destination (0 0 1) (-16 -16 -16) (16 16 32) ?
  -------- KEYS --------
  origin:
  angle:
  targetname:
*/

/*QUAKED info_notnull (0 0 1) (-16 -16 -16) (16 16 32) ?
  -------- KEYS --------
  origin:
  targetname:
*/

/*QUAKED target_explosion (.5 .5 0) (-16 -16 -16) (16 16 32) ?
  -------- KEYS --------
  origin:
  targetname:
  dmg:
*/

// -----------------------------------------------------------------------------
//  MOVERS  (brush entities)
//
//  Only func_plat and func_door are registered (BspEntityHandlers).
//  func_door only moves when "angle" is -1 (up) or -2 (down).
//  Authored at the UPPER stop; simulation starts one "height" below.
//  NOTE: the engine computes AABB = submodel AABB + origin -- leave origin
//  at "0 0 0" unless you deliberately want an offset.
// -----------------------------------------------------------------------------
/*QUAKED func_door (0 .5 .8) ? REVERSE - CRUSHER
  -------- KEYS --------
  model: Submodel (*N) -- required
  origin: Offset -- leave 0 0 0
  angle: -1 = up, -2 = down -- required
  height: Travel Distance
  lip: Lip (kept open) (default: 8)
  speed: Speed (units/s) (default: 100)
  wait: Wait Open (s) (default: 2)
  dmg: Crush Damage (default: 2)
  targetname: Target Name
  noise_start: Start Sound
  noise_stop: Stop Sound
*/

/*QUAKED func_plat (0 .5 .8) ? - - CRUSHER
  -------- KEYS --------
  model: Submodel (*N) -- required
  origin: Offset -- leave 0 0 0
  height: Travel Distance -- required
  speed: Speed (units/s) (default: 200)
  wait: Wait (s) (default: 1)
  dmg: Crush Damage (default: 2)
  targetname: Target Name
  noise_start: Move Sound
  noise_stop: Stop Sound
*/

