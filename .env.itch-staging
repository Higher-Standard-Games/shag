# The itch.io staging build: npm run build:itch-staging, written to
# dist-itch-staging/. The itch build plus a "Local" region when served from
# this machine (npm run preview): the lobby on ws://localhost:9000 and data
# from the dev server on http://localhost:3000. Browsers keep a page on
# itch.io from reaching localhost, so on itch.io it offers EU and US only.
VITE_HOSTED=itch
VITE_LOCAL_REGION=1
